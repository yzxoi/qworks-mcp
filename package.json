{
  "name": "@yzxoi/qworks-mcp",
  "version": "0.1.0",
  "description": "Standalone SDK and stdio MCP adapter for QWorks",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "node": ">=24.11.0" },
  "bin": { "qworks-mcp": "bin/qworks-mcp.mjs" },
  "exports": { ".": "./src/sdk.mjs" },
  "files": ["bin/", "src/", "vendor/", "README.md", "NOTICE.md", "docs/"],
  "repository": { "type": "git", "url": "git+ssh://git@github.com/yzxoi/qworks-mcp.git" },
  "scripts": {
    "start": "node bin/qworks-mcp.mjs",
    "doctor": "node bin/qworks-mcp.mjs --doctor",
    "extract": "node scripts/extract-sdk.cjs",
    "test": "node --test tests/*.test.mjs",
    "check:content": "node scripts/check-content.mjs",
    "verify": "npm run check:content && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@babel/parser": "8.0.5",
    "@babel/traverse": "8.0.5"
  }
}
